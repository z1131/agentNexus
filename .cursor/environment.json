{
  "name": "AgentOZ",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "rag-service",
      "command": "cd agentoz-rag && . .venv/bin/activate && exec uvicorn app.main:app --host 0.0.0.0 --port 18000"
    }
  ],
  "ports": [18000, 8080, 8848]
}
